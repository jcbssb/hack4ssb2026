{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssb.no/schemas/dialogue-schema-v1.json",
  "title": "SSB Dialogue Schema Baseline Specification",
  "description": "Single Source of Truth (SSOT) capturing semantic dialogue flow, field bindings, and design annotations decoupled from execution targets.",
  "type": "object",
  "properties": {
    "dialogueId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique identifier for the dialogue/form (e.g., ssb-hackday-2026)"
    },
    "title": {
      "type": "string",
      "description": "Title of the survey or form"
    },
    "context": {
      "type": "object",
      "properties": {
        "surveyCode": { "type": "string", "example": "RA-0666" },
        "organization": { "type": "string", "default": "Statistisk sentralbyrå" },
        "legalNotice": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QuestionStep"
      }
    }
  },
  "required": ["dialogueId", "title", "steps"],
  "$defs": {
    "QuestionStep": {
      "type": "object",
      "properties": {
        "fieldId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Identifier used for data model bindings (Altinn simpleBinding and JSON payload key)"
        },
        "prompt": {
          "type": "object",
          "properties": {
            "label": { "type": "string", "description": "Primary label / question text" },
            "helpText": { "type": "string", "description": "Optional guidance or instruction text" }
          },
          "required": ["label"]
        },
        "questionType": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["text", "integer", "choice"]
            },
            "options": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["type"]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "annotations": {
          "type": "object",
          "description": "Optional UI/UX hints for Figma or Altinn interpreters",
          "properties": {
            "placeholder": { "type": "string" },
            "componentHint": { "type": "string", "enum": ["Input", "RadioButtons", "Dropdown"] }
          }
        }
      },
      "required": ["fieldId", "prompt", "questionType", "required"]
    }
  }
}
