{
    "$defs": {
        "BolkStep": {
            "properties": {
                "bolkId": {
                    "type": "string"
                },
                "condition": {
                    "$ref": "#/$defs/Predicate"
                },
                "description": {
                    "type": "string"
                },
                "questions": {
                    "items": {
                        "$ref": "#/$defs/QuestionStep"
                    },
                    "type": "array"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "const": "bolk",
                    "type": "string"
                }
            },
            "required": [
                "bolkId",
                "title",
                "questions"
            ],
            "type": "object"
        },
        "Calculation": {
            "properties": {
                "expr": {
                    "$ref": "#/$defs/Expr"
                },
                "fieldId": {
                    "description": "Numeric question receiving the computed value",
                    "type": "string"
                }
            },
            "required": [
                "fieldId",
                "expr"
            ],
            "type": "object"
        },
        "Constraint": {
            "properties": {
                "comparison": {
                    "enum": [
                        "eq",
                        "notEq",
                        "lt",
                        "lte",
                        "gt",
                        "gte"
                    ],
                    "type": "string"
                },
                "condition": {
                    "$ref": "#/$defs/Predicate",
                    "description": "Only check the rule when this predicate holds"
                },
                "constraintId": {
                    "type": "string"
                },
                "left": {
                    "$ref": "#/$defs/Expr"
                },
                "message": {
                    "description": "Shown to the respondent when the rule does not hold",
                    "type": "string"
                },
                "reportOn": {
                    "description": "Fields that show the message; defaults to the entered (non-calculated) fields referenced",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "right": {
                    "$ref": "#/$defs/Expr"
                },
                "severity": {
                    "default": "error",
                    "enum": [
                        "error",
                        "warning"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "constraintId",
                "left",
                "comparison",
                "right",
                "message"
            ],
            "type": "object"
        },
        "Expr": {
            "description": "Numeric expression over field values. Empty fields count as 0; division by zero has no value.",
            "properties": {
                "fieldId": {
                    "type": "string"
                },
                "left": {
                    "$ref": "#/$defs/Expr"
                },
                "op": {
                    "enum": [
                        "field",
                        "const",
                        "add",
                        "sub",
                        "mul",
                        "div"
                    ],
                    "type": "string"
                },
                "right": {
                    "$ref": "#/$defs/Expr"
                },
                "terms": {
                    "items": {
                        "$ref": "#/$defs/Expr"
                    },
                    "type": "array"
                },
                "value": {
                    "type": "number"
                }
            },
            "required": [
                "op"
            ],
            "type": "object"
        },
        "Predicate": {
            "properties": {
                "comparison": {
                    "enum": [
                        "eq",
                        "notEq",
                        "lt",
                        "lte",
                        "gt",
                        "gte"
                    ],
                    "type": "string"
                },
                "conditions": {
                    "items": {
                        "$ref": "#/$defs/Predicate"
                    },
                    "type": "array"
                },
                "fieldId": {
                    "type": "string"
                },
                "left": {
                    "$ref": "#/$defs/Expr"
                },
                "op": {
                    "enum": [
                        "equals",
                        "notEquals",
                        "isTrue",
                        "compare",
                        "and",
                        "or"
                    ],
                    "type": "string"
                },
                "right": {
                    "$ref": "#/$defs/Expr"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "op"
            ],
            "type": "object"
        },
        "QuestionStep": {
            "properties": {
                "annotations": {
                    "description": "Optional UI/UX hints for Figma or Altinn interpreters",
                    "properties": {
                        "componentHint": {
                            "enum": [
                                "Input",
                                "TextArea",
                                "RadioButtons",
                                "Checkboxes",
                                "Dropdown",
                                "Datepicker"
                            ],
                            "type": "string"
                        },
                        "maxLength": {
                            "type": "integer"
                        },
                        "placeholder": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "condition": {
                    "$ref": "#/$defs/Predicate"
                },
                "fieldId": {
                    "description": "Identifier used for data model bindings (Altinn simpleBinding and JSON payload key)",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
                    "type": "string"
                },
                "prompt": {
                    "properties": {
                        "helpText": {
                            "description": "Optional guidance or instruction text",
                            "type": "string"
                        },
                        "label": {
                            "description": "Primary label / question text",
                            "type": "string"
                        }
                    },
                    "required": [
                        "label"
                    ],
                    "type": "object"
                },
                "questionType": {
                    "properties": {
                        "options": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "type": {
                            "enum": [
                                "text",
                                "textarea",
                                "integer",
                                "decimal",
                                "date",
                                "boolean",
                                "choice",
                                "multichoice"
                            ],
                            "type": "string"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "type": "object"
                },
                "required": {
                    "default": false,
                    "type": "boolean"
                }
            },
            "required": [
                "fieldId",
                "prompt",
                "questionType",
                "required"
            ],
            "type": "object"
        }
    },
    "$id": "https://ssb.no/schemas/dialogue-schema-v1.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Single Source of Truth (SSOT) capturing semantic dialogue flow, field bindings, and design annotations decoupled from execution targets.",
    "properties": {
        "calculations": {
            "description": "Derived fields whose value is always given by an expression (totals, remainders)",
            "items": {
                "$ref": "#/$defs/Calculation"
            },
            "type": "array"
        },
        "constraints": {
            "description": "Cross-field rules that must hold, e.g. parts adding up to a total",
            "items": {
                "$ref": "#/$defs/Constraint"
            },
            "type": "array"
        },
        "context": {
            "properties": {
                "legalNotice": {
                    "type": "string"
                },
                "organization": {
                    "type": "string"
                },
                "surveyCode": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "dialogueId": {
            "description": "Unique identifier for the dialogue/form (e.g., ssb-hackday-2026)",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
        },
        "steps": {
            "items": {
                "anyOf": [
                    {
                        "$ref": "#/$defs/QuestionStep"
                    },
                    {
                        "$ref": "#/$defs/BolkStep"
                    }
                ]
            },
            "type": "array"
        },
        "title": {
            "description": "Title of the survey or form",
            "type": "string"
        }
    },
    "required": [
        "dialogueId",
        "title",
        "steps"
    ],
    "title": "SSB Dialogue Schema Baseline Specification",
    "type": "object"
}