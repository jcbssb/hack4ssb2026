{
    "$defs": {
        "Predicate": {
            "properties": {
                "conditions": {
                    "items": {
                        "$ref": "#/$defs/Predicate"
                    },
                    "type": "array"
                },
                "fieldId": {
                    "type": "string"
                },
                "op": {
                    "enum": [
                        "equals",
                        "notEquals",
                        "isTrue",
                        "and",
                        "or"
                    ],
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "op"
            ],
            "type": "object"
        },
        "QuestionStep": {
            "properties": {
                "annotations": {
                    "description": "Optional UI/UX hints for Figma or Altinn interpreters",
                    "properties": {
                        "componentHint": {
                            "enum": [
                                "Input",
                                "TextArea",
                                "RadioButtons",
                                "Checkboxes",
                                "Dropdown",
                                "Datepicker"
                            ],
                            "type": "string"
                        },
                        "maxLength": {
                            "type": "integer"
                        },
                        "placeholder": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "condition": {
                    "$ref": "#/$defs/Predicate"
                },
                "fieldId": {
                    "description": "Identifier used for data model bindings (Altinn simpleBinding and JSON payload key)",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
                    "type": "string"
                },
                "prompt": {
                    "properties": {
                        "helpText": {
                            "description": "Optional guidance or instruction text",
                            "type": "string"
                        },
                        "label": {
                            "description": "Primary label / question text",
                            "type": "string"
                        }
                    },
                    "required": [
                        "label"
                    ],
                    "type": "object"
                },
                "questionType": {
                    "properties": {
                        "options": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "type": {
                            "enum": [
                                "text",
                                "textarea",
                                "integer",
                                "decimal",
                                "date",
                                "boolean",
                                "choice",
                                "multichoice"
                            ],
                            "type": "string"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "type": "object"
                },
                "required": {
                    "default": false,
                    "type": "boolean"
                }
            },
            "required": [
                "fieldId",
                "prompt",
                "questionType",
                "required"
            ],
            "type": "object"
        }
    },
    "$id": "https://ssb.no/schemas/dialogue-schema-v1.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Single Source of Truth (SSOT) capturing semantic dialogue flow, field bindings, and design annotations decoupled from execution targets.",
    "properties": {
        "context": {
            "properties": {
                "legalNotice": {
                    "type": "string"
                },
                "organization": {
                    "type": "string"
                },
                "surveyCode": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "dialogueId": {
            "description": "Unique identifier for the dialogue/form (e.g., ssb-hackday-2026)",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
        },
        "steps": {
            "items": {
                "$ref": "#/$defs/QuestionStep"
            },
            "type": "array"
        },
        "title": {
            "description": "Title of the survey or form",
            "type": "string"
        }
    },
    "required": [
        "dialogueId",
        "title",
        "steps"
    ],
    "title": "SSB Dialogue Schema Baseline Specification",
    "type": "object"
}